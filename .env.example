# Pooled Neon URL for application runtime. Keep the value out of Git and chat.
OFFICE_DATABASE_URL=
# Direct Neon URL for future migrations only.
OFFICE_DIRECT_DATABASE_URL=
# Render Key Value URL for future worker queues.
OFFICE_REDIS_URL=

# Server-only AES-256-GCM key, base64-encoded to exactly 32 bytes. This key and
# all Tray bootstrap values are secret names only: never place real values in Git, chat, clients, logs, or tool results.
TRAY_TOKEN_ENCRYPTION_KEY=
# Controlled server-side Tray connection bootstrap variables. The worker uses
# them to bootstrap or refresh encrypted server-only Tray token material; no
# public callback or provider-write route accepts them.
TRAY_BOOTSTRAP_CLIENT_ID=
TRAY_BOOTSTRAP_CLIENT_SECRET=
TRAY_BOOTSTRAP_AUTHORIZATION_CODE=
TRAY_BOOTSTRAP_API_ADDRESS=
