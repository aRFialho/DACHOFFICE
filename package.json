{
  "name": "dachbyte-office",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @dachbyte-office/worker test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "queue:smoke": "pnpm --filter @dachbyte-office/worker queue:smoke",
    "db:health": "node --env-file=.env scripts/db-health.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "pg": "8.23.0",
    "prettier": "3.8.2",
    "typescript-eslint": "8.64.0"
  }
}
