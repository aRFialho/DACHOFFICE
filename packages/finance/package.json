{
  "name": "@dachbyte-office/finance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./classification": {
      "types": "./dist/classification.d.ts",
      "default": "./dist/classification.js"
    },
    "./contribution-margin": {
      "types": "./dist/contribution-margin.d.ts",
      "default": "./dist/contribution-margin.js"
    },
    "./postgres-financial-component-repository": {
      "types": "./dist/postgres-financial-component-repository.d.ts",
      "default": "./dist/postgres-financial-component-repository.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude dist/**",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.0"
  }
}
